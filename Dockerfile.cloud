FROM node:22-bookworm-slim AS dashboard
WORKDIR /build/dashboard
COPY dashboard/package*.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
COPY engineering_os/catalog.json /build/engineering_os/catalog.json
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ENV VITE_CLOUD_MODE=true
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-cloud.lock ./
RUN pip install --no-cache-dir -r requirements-cloud.lock
COPY pyproject.toml ./
COPY engineering_os/ engineering_os/
COPY hiyo_cloud/ hiyo_cloud/
COPY device_agent/ device_agent/
RUN pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home hiyo
COPY --from=dashboard /build/dashboard/dist dashboard/dist/
USER 10001
ENV HIYO_DASHBOARD_DIR=/app/dashboard/dist
EXPOSE 8080
CMD ["uvicorn", "hiyo_cloud.factory:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
